// Debug build settings for the Passport app.
//
// Values are substituted into Info.plist at build time and read back at
// runtime from `Bundle.main` by `Config.swift`. We keep `scheme` and
// `host` as separate build settings (rather than the full URL) so the
// `//` in `https://` never appears inside an xcconfig value — xcconfig
// treats `//` as a comment marker and there's no clean escape.

// Passport backend (mothers/passport, run with `npm run dev`).
API_BASE_SCHEME = http
API_BASE_HOST = localhost:3001

// Wallet-card backend (mothers/backend). Defaults to the same host as
// the passport API for local dev; override per your environment.
WALLET_API_BASE_SCHEME = http
WALLET_API_BASE_HOST = localhost:3001
